# Copy this file to `.env` (or export these as real environment variables) and fill in real values.

# JWT signing secret - use a long random string in production
SECRET_KEY=change_this_to_a_long_random_string

# Admin dashboard login (separate from normal user accounts)
ADMIN_EMAIL=admin@resumly.com
ADMIN_PASSWORD=ChangeMeAdmin123!

# SMTP settings used by the "Share via Email" feature.
# Example values for Gmail (use an App Password, not your normal password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com
SMTP_USE_TLS=true
